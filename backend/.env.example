PORT=5000
FRONTEND_URL=http://localhost:3000
# Set an independently generated secret with at least 32 characters.
JWT_SECRET=
DATABASE_PATH=./data/onebrain.db
OPENAI_API_KEY=
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
# Optional: Google login (Google Cloud OAuth client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT=
# Password-reset email requires SMTP; reset tokens are never written to logs.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=onebrain@localhost

ENABLE_HOST_AI=0
ENABLE_CLOUD_SPEECH=0
