{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "onebrain-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-06",
  "workers_dev": false,
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "vars": {
    "FRONTEND_URL": "https://onebrain.pawanhiray88.workers.dev,https://onebrain.pages.dev,https://onebrain.handcricket.com",
    "PLATFORM_MODE": "normal",
    "SCHEDULED_JOB_BATCH_SIZE": "2"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "onebrain-db",
      "database_id": "820e6832-45d3-468b-852f-c6cb0b28f0a0",
      "migrations_dir": "./migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 240,
        "period": 60
      }
    },
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ],
  "preview_urls": false
}
