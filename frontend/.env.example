NEXT_PUBLIC_API_URL=
# Host-level keys (optional — users can also paste their own free key in Settings):
GEMINI_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Preview-safe optional Express proxy. Browser calls /backend, never localhost.
# BACKEND_URL=http://127.0.0.1:5000
# NEXT_PUBLIC_API_URL=/backend

# Browser speech is the default. Enable only after reviewing provider costs/privacy.
# NEXT_PUBLIC_ENABLE_CLOUD_SPEECH=1

# Host-funded AI is off unless explicitly enabled after reviewing provider quotas/costs.
ENABLE_HOST_AI=0
ENABLE_CLOUD_SPEECH=0

# Server-only shared platform origin; setup-platform.mjs configures local development.
# Never expose this configuration or connector secrets as NEXT_PUBLIC_* keys.
# PLATFORM_API_URL=http://127.0.0.1:8787
